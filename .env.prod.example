# Copy to .env next to docker-compose.prod.yml on the homelab box and fill
# in real values. Never commit the filled-in .env — it's already excluded
# via .gitignore/.dockerignore.

POSTGRES_USER=nosh
POSTGRES_PASSWORD=
POSTGRES_DB=nosh

# Long random string — e.g. `openssl rand -hex 32`. Signs the session
# cookie; anyone with this value could forge a session.
SESSION_SECRET=

# Every origin the frontend is served from, comma-separated, exactly as the
# browser sends it: scheme + host + port, no path, no trailing slash, and no
# :443/:80 — a browser never sends the default port, so "https://x:443" would
# never match (the backend refuses to start with it rather than silently
# 403ing every request). List both origins while moving from one to the other.
#   This box, during the move:
#     FRONTEND_ORIGINS=https://nosh.itsthomassito.com,http://homelab.tail43ff2b.ts.net:8080
#   After the tailnet URL is retired:
#     FRONTEND_ORIGINS=https://nosh.itsthomassito.com
# (FRONTEND_ORIGIN, singular, is the older name and still read when
# FRONTEND_ORIGINS is unset.)
FRONTEND_ORIGINS=

# IPs of the reverse proxies allowed to report the real client IP and scheme
# (X-Forwarded-For / X-Forwarded-Proto), comma-separated. That is only the
# backend's *direct* peer — the frontend container, whose nginx proxies /api
# — at its fixed address on the `edge` network in docker-compose.prod.yml.
# Never a subnet: any container inside it could then claim to be any client.
# Empty = trust nobody (right for the old direct :3101 access).
#   This box: TRUSTED_PROXIES=10.101.0.10
TRUSTED_PROXIES=

# Anyone who can reach the site can create an account while this is true —
# and with it spend the Gemini quota and fill the uploads volume. Defaults to
# false; switch on briefly to create an account, then off again.
#   This box: ALLOW_SIGNUP=false
ALLOW_SIGNUP=false

# Backend-only (never a VITE_* var — it must not reach the browser). Powers
# recipe import from a URL, and from Instagram Reels/TikTok; get a free key
# at https://aistudio.google.com/apikey. Leave unset and /import returns
# 503 — the rest of the app works fine.
GEMINI_API_KEY=
# Optional: override the model used for each extraction path without a code
# change — useful if a model id gets retired or a free-tier quota gets hit.
# Defaults: gemini-3.6-flash (text), gemini-3.5-flash-lite (video).
GEMINI_TEXT_MODEL=
GEMINI_VIDEO_MODEL=
# Optional: the models users can pick under Settings → Magic import, each with
# its free-tier requests-per-day limit (used for the "~N left today" estimate;
# omit "=N" for a model whose limit you don't know). The two defaults above
# are always included. Default:
#   gemini-3.6-flash=20,gemini-3.5-flash-lite=500
GEMINI_MODELS=

# Web Push, for "your import is ready" notifications. Generate a key pair
# once with `pnpm --filter backend exec web-push generate-vapid-keys` and
# keep it: changing it later invalidates every device's subscription.
# VAPID_SUBJECT must be a mailto: or https:// URL (Apple rejects anything
# else). Leave all three unset and notifications are simply off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Image tag to run. "latest" (the default if unset) tracks whatever CI last
# published from main — what Watchtower polls for updates. Pin to a specific
# build to hold back a version instead: every build is tagged both
# "sha-<first 7 chars of the commit>" and the full commit SHA.
TAG=latest
