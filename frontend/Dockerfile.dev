FROM node:22-alpine
RUN corepack enable

WORKDIR /repo

# Only the workspace manifests are copied — not the source. docker-compose
# bind-mounts the repo over /repo at runtime, so baking the source in would
# be both redundant and a way for unrelated files in the build context to end
# up in the image. Installing from manifests alone also means a source edit
# doesn't invalidate the (slow) install layer.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/

RUN pnpm install && chown -R node:node /repo

WORKDIR /repo/frontend
EXPOSE 5173

USER node
# `pnpm exec vite` rather than `pnpm dev` (which runs the "dev" script via
# `pnpm run`): a `pnpm run`/`pnpm <script>` invocation triggers pnpm's
# pre-script dependency-status check, which false-positives against the
# bind-mounted repo here and then crash-loops trying to interactively
# confirm a node_modules purge with no TTY available — see docs/decisions.md.
# `pnpm exec` resolves and runs the binary directly, skipping that check.
CMD ["pnpm", "exec", "vite", "--host"]
