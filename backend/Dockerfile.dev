FROM node:22-alpine
# corepack enable, then yt-dlp (+ ffmpeg, pulled in as its dependency) for
# Reels/TikTok import — installed from Alpine's own package repo rather than
# the standalone PyInstaller binary GitHub publishes, which is glibc-built
# and unreliable on musl-based Alpine. See docs/decisions.md for the
# version-drift trade-off this implies (apk's yt-dlp lags upstream releases;
# bump by rebuilding the image when platform changes break extraction).
RUN corepack enable && apk add --no-cache yt-dlp

WORKDIR /repo

# Only the workspace manifests are copied — not the source. docker-compose
# bind-mounts the repo over /repo at runtime, so baking the source in would
# be both redundant and a way for unrelated files in the build context to end
# up in the image. Installing from manifests alone also means a source edit
# doesn't invalidate the (slow) install layer.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/

RUN pnpm install && mkdir -p backend/uploads && chown -R node:node /repo

WORKDIR /repo/backend
EXPOSE 3001

USER node
CMD ["pnpm", "dev"]
