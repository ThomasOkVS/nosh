{
  "name": "@nosh/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/app.ts",
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file=../.env.example --env-file-if-exists=../.env dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@nosh/shared": "workspace:*",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.3.0",
    "heic-decode": "^2.1.0",
    "hono": "^4.13.21",
    "postgres": "^4.1.1",
    "sharp": "^0.35.5",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
